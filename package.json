{
  "name": "superdrafts",
  "version": "1.0.0",
  "private": true,
  "description": "Super Drafts, a two-player superhero back-issue auction.",
  "scripts": {
    "login": "vercel login --global-config .vercel-cli",
    "logout": "vercel logout --global-config .vercel-cli",
    "whoami": "vercel whoami --global-config .vercel-cli",
    "setkey": "cd site && vercel env add GROQ_API_KEY production --global-config ../.vercel-cli",
    "envls": "cd site && vercel env ls --global-config ../.vercel-cli",
    "deploy": "vercel deploy site --prod --global-config .vercel-cli",
    "serve": "python3 -m http.server 8791 --directory site"
  },
  "devDependencies": {
    "vercel": "^58.9.0"
  }
}
